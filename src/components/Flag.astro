---

<svg class="flag" viewBox="0 0 30 20" width="22" height="15" aria-hidden="true">
  {code === 'en' && (
    // The "Anglosphere" flag (Union Jack, US stripes, Canada's maple leaf in a ring of 50 stars) from the owner's
    // portfolio (johnson-portfolio public/flags/en.svg, see its LICENSE.md; maple leaf public domain): English for
    // every English-speaking player, not one country. Its 2000×1298 art without the round mask, scaled to 30×20;
    // the canton's clip is a nested <svg> (no ids, so the flag can repeat on a page).
    <g transform="scale(0.015 0.01541)" set:html={EN_FLAG} />
  )}
  {code === 'pt-br' && (
    <>
      <rect width="30" height="20" fill="#009b3a" />
      <polygon points="15,2.2 27.5,10 15,17.8 2.5,10" fill="#fedf00" />
      <circle cx="15" cy="10" r="4.3" fill="#002776" />
    </>
  )}
  {code === 'ko' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      <g transform="rotate(33.7 15 10)">
        <path d="M10 10a5 5 0 0 1 10 0z" fill="#cd2e3a" />
        <path d="M10 10a5 5 0 0 0 10 0z" fill="#0047a0" />
        <circle cx="12.5" cy="10" r="2.5" fill="#cd2e3a" />
        <circle cx="17.5" cy="10" r="2.5" fill="#0047a0" />
      </g>
      {[
        [-33.7, 4.2, 5.4],
        [33.7, 25.8, 5.4],
        [33.7, 4.2, 14.6],
        [-33.7, 25.8, 14.6],
      ].map(([a, x, y]) => (
        <g transform={`rotate(${a} ${x} ${y})`} fill="#000">
          <rect x={x - 2} y={y - 1.8} width="4" height="0.8" />
          <rect x={x - 2} y={y - 0.4} width="4" height="0.8" />
          <rect x={x - 2} y={y + 1} width="4" height="0.8" />
        </g>
      ))}
    </>
  )}
  {code === 'ja' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      <circle cx="15" cy="10" r="6" fill="#bc002d" />
    </>
  )}
  {code === 'zh' && (
    <>
      <rect width="30" height="20" fill="#de2910" />
      <polygon points={star(5, 5, 3)} fill="#ffde00" />
      {[
        [10, 2, 23],
        [12, 4, 45],
        [12, 7, 70],
        [10, 9, 90],
      ].map(([x, y, a]) => (
        <polygon points={star(x, y, 1, a + 180)} fill="#ffde00" />
      ))}
    </>
  )}
  {code === 'de' && (
    <>
      <rect width="30" height="6.67" fill="#000" />
      <rect y="6.67" width="30" height="6.67" fill="#dd0000" />
      <rect y="13.33" width="30" height="6.67" fill="#ffce00" />
    </>
  )}
  {code === 'fr' && (
    <>
      <rect width="10" height="20" fill="#002395" />
      <rect x="10" width="10" height="20" fill="#fff" />
      <rect x="20" width="10" height="20" fill="#ed2939" />
    </>
  )}
  {code === 'es' && (
    <>
      <rect width="30" height="20" fill="#aa151b" />
      <rect y="5" width="30" height="10" fill="#f1bf00" />
    </>
  )}
  {code === 'pl' && (
    <>
      <rect width="30" height="10" fill="#fff" />
      <rect y="10" width="30" height="10" fill="#dc143c" />
    </>
  )}
  {code === 'sv' && (
    <>
      <rect width="30" height="20" fill="#006aa7" />
      <rect x="9.375" width="3.75" height="20" fill="#fecc02" />
      <rect y="8" width="30" height="4" fill="#fecc02" />
    </>
  )}
  {code === 'ru' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      <rect y="6.67" width="30" height="6.67" fill="#0039a6" />
      <rect y="13.33" width="30" height="6.67" fill="#d52b1e" />
    </>
  )}
</svg>

---
// The home page (the event list) in one language: / is English (src/pages/index.astro), /<lang>/ the others
// (src/pages/[lang]/index.astro). Texts in ./home.i18n.ts; each card's text from its guide's frontmatter.
import Base from '../layouts/Base.astro';
import Art from './Art.astro';
import { eventCard, eventUrl, getEvents, homeLangs } from '../lib/events';
import { fluid } from '../lib/images';
import { fmt, hreflang, type Lang } from '../lib/i18n';
import { HOME_TEXT, formatDate } from './home.i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = HOME_TEXT[lang];
const tag = hreflang(lang);

const events = await getEvents();
// An event is linked only when it has a page (src/pages/<slug>/index.astro); otherwise its card is shown unlinked.
// Card background: events/<Dir>/banner.* (official season key art; source in its images/INDEX.md).
const cards = await Promise.all(
  events.map(async (e) => ({
    ...e,
    ...eventCard(e, lang),
    bg: e.banner ? await fluid(e.banner, [480, 800, 1200, 1600]) : null,
  })),
);
// The card spans the content column: viewport minus the 16 px gutters, capped at main's 1180 px.
const SIZES = '(max-width: 1212px) calc(100vw - 32px), 1180px';
---

<Base
  title={t.title}
  description={t.desc}
  lang={tag}
  langs={homeLangs(lang)}
  image={events.find((e) => e.banner)?.banner}
>
  <header class="brand-hero">
    <h1 class="wordmark">
      TLI <span>Events</span>
    </h1>
    <p class="tagline">{t.tagline}</p>
    <p class="lead">{t.lead}</p>
  </header>
  <section class="event-list" aria-label={t.events}>
    {cards.map((e, i) => {
      const body = (
        <>
          <Art img={e.bg} class="bg" sizes={SIZES} eager={i === 0} />
          <div class="txt">
            <div class="code">{fmt(t.since, { code: e.code, date: formatDate(e.launched, tag) })}</div>
            <h2>{e.name}</h2>
            <div>
              <b>{e.mechanic}</b> — {e.summary}
            </div>
          </div>
        </>
      );
      return e.hasPage ? (
        <a class="season-card" href={eventUrl(e, lang)}>
          {body}
        </a>
      ) : (
        <div class="season-card soon">{body}</div>
      );
    })}
  </section>
</Base>

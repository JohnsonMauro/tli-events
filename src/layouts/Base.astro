---
import '../styles/site.css';
import { url } from '../events';
import Flag from '../components/Flag.astro';

interface Props {
  title: string;
  description?: string;
  /** Back link shown next to the brand on event pages (to the event list). */
  back?: { href: string; label: string };
  /** Full-width main area (the play sheet fills the viewport). */
  wide?: boolean;
  /** Page language (BCP 47). */
  lang?: string;
  /** Translations of this page: language switcher + hreflang links. */
  langs?: { code: string; label: string; name: string; hreflang: string; href: string; current: boolean }[];
}

const { title, description = 'Torchlight: Infinite season strategy', back, wide = false, lang = 'en', langs = [] } = Astro.props;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  {langs.map((l) => <link rel="alternate" hreflang={l.hreflang} href={new URL(l.href, Astro.site ?? Astro.url).href} />)}
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Stencil+Display:wght@700;800&family=IBM+Plex+Mono:wght@400;500&family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    // Apply the saved theme before paint (per-viewer convenience only).
    try { const t = localStorage.getItem('tt-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <nav><div class="in">
    <div class="links">
      <a class="brand" href={url()}>TLI <span>Events</span></a>
      {back && <a class="back" href={back.href}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>{back.label}</a>}
    </div>
    <div class="nav-end">
      <slot name="nav" />
      {langs.length > 0 && (() => { const cur = langs.find((l) => l.current) ?? langs[0]; return (
        <details class="lang-select">
          <summary aria-label={`Language: ${cur.name}`}><Flag code={cur.code} /><span>{cur.name}</span></summary>
          <ul role="list">
            {langs.map((l) => <li><a href={l.href} hreflang={l.hreflang} lang={l.hreflang} aria-current={l.current ? 'page' : undefined}><Flag code={l.code} />{l.name}</a></li>)}
          </ul>
        </details>); })()}
      <button id="theme" type="button" aria-label="Toggle light/dark theme" title="Toggle light/dark theme">
        <svg class="ico-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="ico-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </div>
  </div></nav>
  <main class:list={[{ wide }]}>
    <slot />
  </main>
  <footer class="site-foot">
    TLI Events, made with <svg class="heart" viewBox="0 0 24 24" role="img" aria-label="love"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.8 4.5c2.1 0 3.6 1.2 5.2 3.1 1.6-1.9 3.1-3.1 5.2-3.1 3.8 0 5.9 3.9 4.4 7.3C19.5 16.4 12 21 12 21z" /></svg>
  </footer>
  <script is:inline>
    const langSel = document.querySelector('.lang-select');
    if (langSel) {
      document.addEventListener('click', (e) => { if (!langSel.contains(e.target)) langSel.open = false; });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') langSel.open = false; });
    }
    document.getElementById('theme').addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('tt-theme', root.dataset.theme); } catch (e) {}
    });
  </script>
</body>
</html>

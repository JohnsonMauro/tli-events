---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import EventInfo, { type Credit } from '../../components/EventInfo.astro';
import BackLink from '../../components/BackLink.astro';
import { getEvent, eventLangs, url } from '../../lib/events';
import { artSet } from '../../lib/images';
import { fmt, hreflang, rich, type Lang } from '../../lib/i18n';
import { DICT } from './i18n';
import { DOUBT, PAIR_LINKED, TOOL_LINKS } from './tool-text';
import { INFO } from '../../components/event-info.i18n';
import { SIM_TIME } from './sim-time';
import { ISSUES_URL, REPO_URL } from '../../lib/project';
// Live odds only (offer counts measured by the community analyzer, frozen at 2026-10-16).
import data from '../../../events/SS14_Tartarus/data/tartarus_data.json';
// Every number on the sheet: our own engine (events/SS14_Tartarus/engine, `tartarus export`).
import engine from '../../../events/SS14_Tartarus/data/engine_results.json';
import credits from '../../../events/SS14_Tartarus/credits.json';
// CoffeeBns' Tartarus Simulator: where players can practice a board (its numbers differ from ours).
const SIMULATOR_URL = 'https://blahdot3h.github.io/tartarus-simulator/';
// Our engine's README: what it simulates, its sources and open rules.
const ENGINE_URL = `${REPO_URL}/tree/main/events/SS14_Tartarus/engine`;
// The r/TorchlightInfinite thread where the play sheet is discussed: the other place to send prints and numbers.
const REDDIT_URL = 'https://www.reddit.com/r/TorchlightInfinite/comments/1x839x1/comment/pha1kgm/';
import './play.css';

// Play sheet for SS14 in one language: general patterns of the Warden's Duty, strong instrument pairs,
// the instrument ranking (interactive pick, ./play.ts) and when to take each treasure/incident.
// Pages: src/pages/ss14/index.astro (en) and src/pages/ss14/[lang].astro. Texts: ./i18n.ts.
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = DICT[lang];
const event = await getEvent('ss14');
const langs = eventLangs(event, lang);

// Game art cut by events/SS14_Tartarus/scripts/game_art.py (sources in art/SOURCES.md), optimized per box size.
const A = artSet(
  import.meta.glob<{ default: ImageMetadata }>('../../../events/SS14_Tartarus/art/*.webp', { eager: true }),
);

// ---- instruments: our value → tier (vs. a run with no instrument), grouped by tier ----
type Pair = [string, string, number];
type Values = Record<string, number>;
interface Engine {
  base: number;
  tools: Record<string, { name: string; value: number }>;
  pairs: Pair[];
  // Per start card (rules change) and per objective (rewards on); absent before the first full export.
  byStart?: Record<string, { base: number; tools: Values; pairs: Pair[] }>;
  byObjective?: Record<string, { base: number; tools: Values }>;
  // What one "!" of each kind is worth, in Rainbows per run over an average one; absent before that export.
  incidents?: Record<string, number>;
  gamesPerTest: number;
}
const E = engine as unknown as Engine;
const base = E.base;
// Our method in numbers, counted the way `tartarus export` runs it: alone + pairs (pairs per start card at half
// the games), per start card, the full run, per objective, per incident.
const G = E.gamesPerTest;
const starts = Object.values(E.byStart ?? {});
const objectives = Object.values(E.byObjective ?? {});
const nIncidents = Object.keys(E.incidents ?? {}).length;
const nTools = Object.keys(E.tools).length;
const simTests =
  1 +
  nTools +
  E.pairs.length +
  starts.reduce((n, x) => n + 1 + Object.keys(x.tools).length + x.pairs.length, 0) +
  1 +
  objectives.reduce((n, x) => n + 1 + Object.keys(x.tools).length, 0) +
  nIncidents;
const simRuns =
  G * (1 + nTools + E.pairs.length) +
  starts.reduce((n, x) => n + G * (1 + Object.keys(x.tools).length) + (G / 2) * x.pairs.length, 0) +
  G +
  objectives.reduce((n, x) => n + G * (1 + Object.keys(x.tools).length), 0) +
  G * nIncidents;
const num = new Intl.NumberFormat(hreflang(lang));
const simOurs = fmt(t.simOurs, {
  tests: num.format(simTests),
  runs: new Intl.NumberFormat(hreflang(lang), { notation: 'compact', maximumFractionDigits: 0 }).format(simRuns),
});
// When our numbers were last published (./sim-time.ts): shown in the reader's own zone by ./play.ts. The build
// renders UTC; without git history, only the export's UTC date.
const simUtc = new Intl.DateTimeFormat(hreflang(lang), {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
  ...(SIM_TIME && { hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }),
}).format(new Date(SIM_TIME?.iso ?? (engine as { generated: string }).generated + 'T00:00:00Z'));
const [simBefore, simAfter] = t.simDate.split('{date}');
// Tier = how close an instrument comes to the best one: the share of the best one's gain over a run that holds
// nothing (never shown, every run holds one). Cut on the list in force, so every start card, objective and pair
// list has its own S. E = no gain. (Until 2026-10-18 the cut was a multiple of that run, 2.6×/1.9×/…, taken from
// the community simulator: with a start card the top instrument read B or C.)
const TIERS = [
  ['S', 0.85],
  ['A', 0.65],
  ['B', 0.45],
  ['C', 0.25],
  ['D', 0],
] as const;
const tierIn = (v: number, b: number, best: number) =>
  v <= b || best <= b ? 'E' : (TIERS.find(([, share]) => (v - b) / (best - b) >= share)?.[0] ?? 'D');
const bestOf = (vals: number[]) => Math.max(...vals);
const soloBest = bestOf(Object.values(E.tools).map((x) => x.value));
const tierOf = (v: number) => tierIn(v, base, soloBest);
// One list, best first: art, tier, name, Rainbows per run. ./play.ts re-sorts it for the run's choices.
const tools = Object.entries(E.tools)
  .sort((a, b) => b[1].value - a[1].value)
  .map(([id, x]) => ({
    id,
    name: x.name,
    value: x.value,
    tier: tierOf(x.value),
    art: A('tool-' + id, 'md'), // drawn in an 83 px square: the 80 px set (160 px at 2×) is close enough
    doubt: DOUBT.has(id),
  }));

// ---- your run: start card (from Viktor, changes the rules) and objective; the numbers follow ----
const STARTS = [
  ['', t.runNone, null],
  ['cagefight', 'Cage Fight', A('card-cagefight')],
  ['ironlaw', 'Iron Law', A('card-ironlaw')],
  ['tyranny', 'Tyranny', A('card-tyranny')],
  // Text from a player's print quoted by the community simulator (2026-10-17); no print of ours, so no art yet.
  ['opulence', 'Opulence', null],
] as const;
const OBJECTIVES = [
  ['', t.runAny],
  ['king', 'King of the Caged'],
  ['walk', 'Prison Walk'],
  ['consume', 'Survival of the Fittest'],
  ['undercurrents', 'Undercurrents'],
  ['doors', 'Behind Cell Doors'],
] as const;

// ---- exceptions to "same rarity only" (card texts in images/INDEX.md) ----
const exceptions = [
  ['tool-guillotine', 'Fanged Guillotine: Alpha Wolf', t.exGuillotine],
  ['tool-maul', 'Elephant-Foot Maul: Mammoth', t.exMaul],
  ['card-cagefight', 'Cage Fight', t.exCage],
  ['tool-crown', 'Iron Crown of the Prison King: Berserk Lion', t.exCrown],
  ['tool-skewer', 'Skewered Rat Heads: Colossal Rat', t.exSkewer],
].map(([id, name, text]) => ({ name, text, art: id ? A(id) : null }));

// ---- live offers: a start card's best first picks skip instruments seen in <3% of live offers ----
const offers =
  (data.live as { toolOffers?: { n: number; counts: Record<string, number> } } | undefined)?.toolOffers ?? null;
const offerRate = (id: string) => (offers && offers.n ? (offers.counts[id] ?? 0) / offers.n : null);
const SHOWS_UP = 0.03;
// Full card names: the part after ":" names the beast a beast-specific instrument works for.
const short = (id: string) => E.tools[id]?.name ?? id;

// ---- your run: a popover on each start card and objective chip (what it does; a start card's best first picks) ----
const firstPicks = (start: string) => {
  const x = E.byStart?.[start];
  if (!x) return [];
  return Object.entries(x.tools)
    .filter(([id]) => {
      const r = offerRate(id);
      return r == null || r >= SHOWS_UP;
    })
    .sort((a, b) => b[1] - a[1])
    .slice(0, 3)
    .map(([id, v]) => ({
      name: short(id),
      v,
      tier: tierIn(v, x.base, bestOf(Object.values(x.tools))),
      art: A('tool-' + id),
    }));
};
const startTips = STARTS.filter(([id]) => id).map(([id, name]) => ({
  id,
  name,
  art: A('card-' + id, 'md'),
  does: id === 'ironlaw' ? t.ironlawP : t.run[id as 'cagefight' | 'tyranny' | 'opulence'],
  picks: firstPicks(id),
}));
const objectiveTips = OBJECTIVES.filter(([id]) => id).map(([id, name]) => ({
  id,
  name,
  goal: t.run[id as 'king' | 'walk' | 'consume' | 'undercurrents' | 'doors'],
}));

// ---- incidents: no skip on any card seen (only Confirm) → the choice is stepping on a "!" cell ----
// [id, card name, art id, source of the effect text]; sorted by the engine's worth below
const EVENTS = [
  ['trickster', 'Behind Closed Doors', 'event-trickster', 'live'],
  ['convict', 'High-Risk Convict', 'event-convict', 'live'],
  ['archenemy', 'Archenemy', 'event-archenemy', 'live'],
  ['appetite', 'Ravenous Appetite', 'event-appetite', 'live'],
  ['shared', 'Shared Fortune', 'event-shared', 'live'],
  ['freedom', 'Taste of Freedom', 'event-freedom', 'live'],
  ['portion', 'Extra Portion', 'event-portion', 'live'],
  ['ratway', 'Sewer Ratway', 'event-ratway', 'live'],
  ['hunt', '"Treasure" Hunt', 'event-hunt', 'live'],
  ['crow', 'Crow Whispers', 'event-crow', 'live'],
  ['usurp', 'Usurpation I–IV', 'event-usurp', 'live'],
  ['chain', 'Chain Reaction', 'event-chain', 'vod'],
  ['execution', 'Execution Efficiency', 'event-execution', 'vod'],
] as const;
const SRC = { live: t.srcLive, vod: t.srcVod, sim: t.srcSim };
// Best first by the engine's worth of one "!" (export → incidents); the order above until that export exists.
const worth = (id: string) => (E.incidents ? (E.incidents[id] ?? -1e9) : 0); // finite: a stable sort
const events = [...EVENTS]
  .sort((a, b) => worth(b[0]) - worth(a[0]))
  .map(([id, name, artId, src]) => ({
    id,
    name,
    art: artId ? A(artId, 'lg') : null, // row art: the whole square at 88 px, sharp at 2×
    pop: artId ? A(artId, 'md') : null,
    src: SRC[src],
    // Rainbows per run against an average "!" (sign kept); null before the export measures incidents.
    worth: E.incidents?.[id] == null ? null : (E.incidents[id] > 0 ? '+' : '') + E.incidents[id].toFixed(2),
    up: (E.incidents?.[id] ?? 0) >= 0,
    ...t.inc[id],
  }));

// ---- Warden's Treasure: what each one does (live cards, images/89) and the board where it wins ----
const gifts = [
  ['horn', 'Brass Horn of Strife', t.gHornDo, t.gHorn],
  ['ring', 'Three-Headed Thumb Ring', t.gRingDo, t.gRing],
  ['wine', 'Crimson Vintage', t.gWineDo, t.gWine],
  ['brand', 'Brand of Original Sin', t.gBrandDo, t.gBrand],
].map(([id, name, does, when]) => ({ name, does, when, art: A('gift-' + id, 'lg') }));

// Embedded for the client script; escape "<" so the JSON can never close the tag.
const ui = {
  perRun: t.perRun,
  remove: t.remove,
  nothing: t.nothing,
  pickHint: t.pickHint,
  pickSecond: t.pickSecond,
  offered: t.offered,
  withYou: t.withYou,
  partners: t.partners,
  partnersSub: t.partnersSub,
  rankOf: t.rankOf,
  rankAlone: t.rankAlone,
  rankPair: t.rankPair,
  doubt: t.doubt,
  tool: t.tool,
  pair: t.pair,
  combo: t.combo,
  clashV: t.clashV,
  noCombo: t.noCombo,
  findCount: t.findCount,
  findNone: t.findNone,
  link: t.link,
  clashWhy: t.clashWhy,
};
const json = JSON.stringify({
  tools: E.tools,
  pairs: E.pairs,
  base,
  byStart: E.byStart ?? {},
  byObjective: E.byObjective ?? {},
  tiers: TIERS,
  offers,
  links: TOOL_LINKS,
  linked: [...PAIR_LINKED],
  ui,
}).replace(/</g, '\\u003c');
const ladder = [
  ['act-consume', t.l1b, t.l1e, ''],
  ['incident', t.l2b, t.l2e, 'tall'],
  ['door', t.l3b, t.l3e, ''],
  ['act-replace', t.l4b, t.l4e, ''],
] as const;
---

<Base
  title={`${t.title} · TLI Events`}
  description={t.desc}
  langs={langs}
  lang={hreflang(lang)}
  image={event.banner}
  wide
>
  <EventInfo slot="nav" lang={lang} method={t.method} credits={credits as Credit[]} />
  <div class="sheet-top">
    <BackLink href={url()} label={t.back} />
  </div>
  <div class="play">
    <section class="pane patterns" aria-labelledby="pat-h">
      {/* Each part folds (accordion); ./play.ts remembers which ones the viewer closed. */}
      <details class="acc run" id="run" data-acc="run" open>
        <summary>
          <h2 class="run-h">{t.runH}</h2>
        </summary>
        <p class="meta">{t.runHint}</p>
        <div class="run-row" role="group" aria-label={t.runStart}>
          <span class="run-l">{t.runStart}</span>
          {STARTS.map(([id, name, art]) => (
            <button
              type="button"
              class="opt"
              data-start={id}
              data-tip={id ? `start-${id}` : undefined}
              aria-describedby={id ? 'pop' : undefined}
              aria-pressed={id === '' ? 'true' : 'false'}
            >
              {art && <Art img={art} class="inl" />}
              {name}
            </button>
          ))}
        </div>
        <p class="meta run-note">{t.viktor}</p>
        <div class="run-row" role="group" aria-label={t.runObjective}>
          <span class="run-l">{t.runObjective}</span>
          {OBJECTIVES.map(([id, name]) => (
            <button
              type="button"
              class="opt"
              data-objective={id}
              data-tip={id ? `obj-${id}` : undefined}
              aria-describedby={id ? 'pop' : undefined}
              aria-pressed={id === '' ? 'true' : 'false'}
            >
              {name}
            </button>
          ))}
        </div>
        <ul class="run-facts">
          <li>
            <b>Regular Sentence</b> <span class="meta">{t.regularTag}</span> — {t.regularP}
          </li>
          <li>
            <Art img={A('compass-3')} class="inl" /> <b>{t.compassB}</b> — {t.compassP}
          </li>
          <li>
            <b>Iron Law</b> — {t.ironlawP}
          </li>
        </ul>
      </details>
      <details class="acc" data-acc="win" open>
        <summary>
          <h2 class="pane-h" id="pat-h">
            {t.howToWin}
          </h2>
        </summary>
        <ol class="pat" style={`--step:${JSON.stringify(t.step)}`}>
          <li>
            <div class="pat-art">
              <Art img={A('act-consume', 'md')} />
            </div>
            <div>
              <b>{t.s1t}</b>
              <p>
                <Art img={A('fangs')} class="inl" /> <Fragment set:html={rich(t.s1p)} />
              </p>
            </div>
          </li>
          <li class="wide-li">
            <div class="pat-head">
              <b>{t.s2t}</b>
            </div>
            <div class="eats-grid">
              {[
                ['mammoth', ['lion', 'wolf']],
                ['lion', ['wolf', 'rat']],
                ['wolf', ['rat']],
                ['rat', ['mammoth']],
              ].map(([e, prey]) => (
                <span class="row">
                  <Art img={A(e as string)} alt={e as string} />
                  <i>{t.eats}</i>
                  {(prey as string[]).map((p) => (
                    <Art img={A(p)} alt={p} />
                  ))}
                </span>
              ))}
            </div>
            <p set:html={rich(t.s2p)} />
            <ul class="exc">
              {exceptions.map((x) => (
                <li>
                  {x.art ? <Art img={x.art} /> : <span class="ph">?</span>}
                  <span>
                    <b>{x.name}</b> <Fragment set:html={rich(x.text)} />
                  </span>
                </li>
              ))}
            </ul>
          </li>
          <li>
            <div class="pat-art pair">
              <Art img={A('mammoth')} class="r4" />
              <Art img={A('lion')} class="r4" />
            </div>
            <div>
              <b>{t.s3t}</b>
              <p set:html={rich(t.s3p)} />
            </div>
          </li>
          <li class="wide-li">
            <div class="pat-head">
              <b>{t.s4t}</b>
            </div>
            <p set:html={rich(fmt(t.s4p, { pick: t.pickH }))} />
          </li>
          <li class="wide-li">
            <div class="pat-head">
              <b>{t.s5t}</b>
              <span class="meta">{t.s5sub}</span>
            </div>
            <ol class="ladder">
              {ladder.map(([img, b, e, cls]) => (
                <li>
                  <Art img={A(img)} class={cls || undefined} />
                  <span>
                    <b>{b}</b>
                    <em>{e}</em>
                  </span>
                </li>
              ))}
            </ol>
            <p class="tip" set:html={rich(t.s5tip)} />
          </li>
          <li>
            <div class="pat-art">
              <Art img={A('office', 'md')} />
            </div>
            <div>
              <b>{t.s6t}</b>
              <p set:html={rich(t.s6p)} />
            </div>
          </li>
          <li>
            <div class="pat-art">
              <Art img={A('tile-locked', 'md')} />
            </div>
            <div>
              <b>{t.s7t}</b>
              <p set:html={rich(t.s7p)} />
            </div>
          </li>
        </ol>
      </details>
    </section>
    {/* Before first paint (no jump): the parts this viewer folded stay folded. Per-browser convenience only. */}
    <script is:inline>
      (() => {
        const KEY = 'ss14-acc-v1';
        let open = {};
        try {
          open = JSON.parse(localStorage.getItem(KEY) || '{}') || {};
        } catch {}
        document.querySelectorAll('details[data-acc]').forEach((d) => {
          const id = d.dataset.acc;
          if (typeof open[id] === 'boolean') d.open = open[id];
          d.addEventListener('toggle', () => {
            open[id] = d.open;
            try {
              localStorage.setItem(KEY, JSON.stringify(open));
            } catch {}
          });
        });
      })();
    </script>
    <section class="pane tools-pane" aria-labelledby="tool-h">
      <h2 class="pane-h" id="tool-h">
        {t.pickH}
      </h2>
      <p class="sim-date">
        {simBefore}
        {SIM_TIME ? (
          <time datetime={SIM_TIME.iso} data-sim>
            {simUtc}
          </time>
        ) : (
          simUtc
        )}
        {simAfter}
      </p>
      <p class="sim-cta">
        {t.simCta}{' '}
        <a href={SIMULATOR_URL} target="_blank" rel="noopener noreferrer">
          Tartarus Simulator
        </a>{' '}
        <span class="meta">(CoffeeBns)</span>
        <span class="sim-diff">{t.simDiff}</span>
        <span class="sim-diff">
          {simOurs}{' '}
          <a href={ENGINE_URL} target="_blank" rel="noopener noreferrer">
            {t.simHow}
          </a>
        </span>
      </p>
      {/* one box: what you hold and what to tap next go together */}
      <div class="pick-box">
        <div class="held-row">
          <span class="meta">{t.holding}</span>
          <span id="held">
            <span class="meta">{t.nothing}</span>
          </span>
        </div>
        <div id="pickOut" class="pick-out">
          <p class="meta">{t.pickHint}</p>
        </div>
      </div>
      <div class="tools" id="tools">
        <div class="tool-head">
          {/* narrows the list by name (./play.ts); the names are the English client's, in every language */}
          <search class="find">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="m15.5 15.5 5 5" />
            </svg>
            <input
              type="search"
              id="toolFind"
              aria-label={t.find}
              placeholder={t.findHint}
              aria-controls="toolList"
              autocomplete="off"
              spellcheck="false"
            />
          </search>
          <span>{t.perRun}</span>
          <button type="button" class="tier-info" data-tip="tiers" aria-label={t.tipBtn} aria-describedby="pop">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9.5" />
              <path d="M12 11v6M12 7.5v.5" />
            </svg>
          </button>
        </div>
        <p id="findOut" class="find-out" role="status"></p>
        <ol class="tool-list" id="toolList">
          {tools.map((x) => (
            <li>
              <button
                type="button"
                class="tool"
                data-tool={x.id}
                data-tier={x.tier}
                data-doubt={x.doubt ? '' : undefined}
                aria-describedby="pop"
              >
                <span class="pic">
                  {x.art ? (
                    <Art img={x.art} />
                  ) : (
                    <span class="noart" aria-hidden="true">
                      ?
                    </span>
                  )}
                </span>
                <span class={`tier t${x.tier}`}>{x.tier}</span>
                <span class="nm">
                  <span class="nm-t">
                    {x.name}
                    {x.doubt && (
                      <span class="doubt" aria-hidden="true">
                        !
                      </span>
                    )}
                  </span>
                  {/* once one is held: what this one does with it (t.pair), filled by ./play.ts */}
                  <small class="why" hidden></small>
                </span>
                <b class="val">{x.value.toFixed(2)}</b>
              </button>
            </li>
          ))}
        </ol>
      </div>
      <p class="meta">{t.tierMeta}</p>
      <p class="meta">{t.comboMeta}</p>
      <p class="doubt-note">
        <span class="doubt" aria-hidden="true">
          !
        </span>
        <span>
          {t.doubtNote}{' '}
          <a href={ISSUES_URL} target="_blank" rel="noopener noreferrer">
            {t.doubtIssue}
          </a>{' '}
          ·{' '}
          <a href={REDDIT_URL} target="_blank" rel="noopener noreferrer">
            {t.doubtReddit}
          </a>
        </span>
      </p>
    </section>

    <aside class="pane side" aria-label={`${t.treasureH} · ${t.incH}`}>
      <h2 class="pane-h">{t.treasureH}</h2>
      <ul class="list gifts">
        {gifts.map((g) => (
          <li>
            <span class="pic">
              <Art img={g.art} />
            </span>
            <span class="txt">
              <b>{g.name}</b>
              <span class="does">{g.does}</span>
              <span>
                <em>{t.gWhen}</em> {g.when}
              </span>
            </span>
          </li>
        ))}
      </ul>
      <h2 class="pane-h">
        {t.incH} <Art img={A('incident')} class="inl" />
      </h2>
      <p class="meta">{t.incMeta}</p>
      <ul class="list">
        {events.map((e) => (
          <li class={e.art ? '' : 'noart'}>
            <button type="button" class="ev" data-ev={e.id} aria-describedby="pop">
              {e.art && (
                <span class="pic">
                  <Art img={e.art} />
                </span>
              )}
              <span class="txt">
                <b>
                  {e.name} {e.worth && <strong class={e.up ? 'up' : 'down'}>{e.worth}</strong>}
                </b>
                <span>{e.short}</span>
              </span>
            </button>
            <template id={`ev-${e.id}`}>
              <div class="tp-head">
                {e.pop ? <Art img={e.pop} /> : <span></span>}
                <div>
                  <b>{e.name}</b>
                  <div class="tp-stats">
                    {e.worth && (
                      <>
                        <strong class={e.up ? 'up' : 'down'}>{e.worth}</strong> {t.perRun} ·{' '}
                      </>
                    )}
                    {t.src}: {e.src}
                  </div>
                </div>
              </div>
              <p class="tp-sub">
                <span>{t.does}</span>
                <Fragment set:html={rich(e.does)} />
              </p>
              <p class="tp-sub">
                <span>{t.good}</span>
                {e.good}
              </p>
              <p class="tp-sub">
                <span>{t.bad}</span>
                {e.bad}
              </p>
            </template>
          </li>
        ))}
      </ul>
    </aside>
  </div>
  {startTips.map((c) => (
    <template id={`tip-start-${c.id}`}>
      <div class="tp-head">
        {c.art ? <Art img={c.art} /> : <span></span>}
        <div>
          <b>{c.name}</b>
          <div class="tp-stats">{t.runStart}</div>
        </div>
      </div>
      <p class="tp-what" set:html={rich(c.does)} />
      {c.picks.length > 0 && (
        <div class="tp-sub tp-second">
          <span>{t.run.bestFirst}</span>
          <small>{t.perRun}</small>
          <ol class="tp-pairs">
            {c.picks.map((p) => (
              <li>
                {p.art ? <Art img={p.art} /> : <span class="ph">?</span>}
                <span class={`tier t${p.tier}`}>{p.tier}</span>
                <span class="pn">{p.name}</span>
                <b>{p.v.toFixed(2)}</b>
              </li>
            ))}
          </ol>
        </div>
      )}
    </template>
  ))}
  {objectiveTips.map((o) => (
    <template id={`tip-obj-${o.id}`}>
      <b class="tip-h">{o.name}</b>
      <div class="tp-stats">{t.runObjective}</div>
      <p class="tp-sub">
        <span>{t.run.goalH}</span>
        <Fragment set:html={rich(o.goal)} />
      </p>
      <p class="tp-sub">
        <span>{t.run.rewardH}</span>
        <Fragment set:html={rich(t.run.reward)} />
      </p>
    </template>
  ))}
  <template id="tip-tiers">
    <b class="tip-h">{t.tipH}</b>
    <p class="tip-p">
      <Fragment set:html={rich(t.tipP)} />
    </p>
    <table class="tip-tiers">
      {/* ./play.ts rewrites the numbers for the list in force: start card, objective, or the pair with what you hold */}
      {TIERS.map(([tier, share]) => (
        <tr data-row={tier}>
          <td>
            <span class={`tier t${tier}`}>{tier}</span>
          </td>
          <td data-share={share}>
            {share ? '≥' : '>'}
            {(base + share * (soloBest - base)).toFixed(2)} {t.perRun}
          </td>
        </tr>
      ))}
      <tr data-row="E">
        <td>
          <span class="tier tE">E</span>
        </td>
        <td data-floor>
          ≤{base.toFixed(2)} {t.perRun}
        </td>
      </tr>
    </table>
    <p class="tp-sub">{t.tipNote}</p>
  </template>
  <div class="tool-pop" id="pop" role="tooltip" hidden></div>
  {/* Touch: the same content as a modal dialog — a close button, Esc, a tap outside closes it, it scrolls, and the
      page under it can't be tapped by mistake (./play.ts). Mouse and keyboard keep the tooltip above. */}
  <dialog class="tool-dlg" id="popdlg">
    <button type="button" class="dlg-x" data-close aria-label={INFO[lang].close}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <div class="dlg-body"></div>
  </dialog>
  <script type="application/json" id="play-data" set:html={json} />
</Base>
<script src="./play.ts"></script>

---
// <img> for an optimized image (src/lib/images.ts): srcset + intrinsic size, lazy by default.
// Takes the image or its promise (artSet in src/lib/images.ts); renders nothing when it is null.
import type { HTMLAttributes } from 'astro/types';
import type { Img } from '../lib/images';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'width' | 'height'> {
  img: Img | Promise<Img | null> | null;
  /** Above the fold: load now, at high priority. */
  eager?: boolean;
}
const { img: pending, eager = false, alt = '', ...rest } = Astro.props;
const img = await pending;
---

{img && (
  <img
    src={img.src}
    srcset={img.srcset}
    width={img.width}
    height={img.height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
    {...rest}
  />
)}

---
// "Method & credits" for an event page: a header button that opens a dialog with the methodology,
// thanks + links to the creators whose work the page uses, and the feedback link (GitHub Discussions).
// Usage: <EventInfo slot="nav" lang={lang} method={t.method} credits={credits} /> inside <Base>.
import { INFO, type Role } from '../i18n/event-info';
import { rich, type Lang } from '../i18n/ss14-play';
import { DISCUSSIONS_URL } from '../project';

export interface Credit { name: string; platform: 'youtube' | 'bilibili'; url: string; role: Role }
interface Props { lang: Lang; method: string[]; credits: Credit[] }
const { lang, method, credits } = Astro.props;
const L = INFO[lang];
const ICON = {
  youtube: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="1.5" y="5" width="21" height="14" rx="4" fill="#ff0033"/><path d="M10 9l5 3-5 3z" fill="#fff"/></svg>',
  bilibili: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3l3 3M17 3l-3 3" stroke="#00a1d6" stroke-width="2" stroke-linecap="round"/><rect x="2" y="6" width="20" height="14" rx="4" fill="#00a1d6"/><path d="M8 12v2M16 12v2" stroke="#fff" stroke-width="2" stroke-linecap="round"/></svg>',
};
---
<button type="button" class="info-btn" id="infoBtn" aria-haspopup="dialog" aria-controls="infoDlg">
  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" /><path d="M12 11v6M12 7.5v.5" /></svg>
  <span>{L.btn}</span>
</button>
<dialog class="info-dlg" id="infoDlg" aria-labelledby="infoTitle">
  <div class="info-head">
    <h2 id="infoTitle">{L.title}</h2>
    <button type="button" class="info-x" data-close aria-label={L.close}>✕</button>
  </div>
  <h3>{L.methodH}</h3>
  <ol class="info-method">{method.map((m) => <li set:html={rich(m)} />)}</ol>
  <h3>{L.thanksH}</h3>
  <p class="info-lead">{L.thanksLead}</p>
  <ul class="credits">
    {credits.map((c) => (
      <li><a href={c.url} target="_blank" rel="noopener noreferrer">
        <span class="pf" set:html={ICON[c.platform]} />
        <span class="who"><b>{c.name}</b><em>{c.platform === 'youtube' ? 'YouTube' : 'Bilibili'} · {L.roles[c.role]}</em></span>
        <svg class="ext" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" /></svg>
      </a></li>
    ))}
  </ul>
  <div class="feedback">
    <div><h3>{L.feedbackH}</h3><p>{L.feedbackP}</p></div>
    <a class="gh" href={DISCUSSIONS_URL} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.4 1.1 2.9.8.1-.6.4-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .6 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2z" /></svg>
      {L.feedbackBtn}
    </a>
  </div>
</dialog>
<script is:inline>
  (() => {
    const btn = document.getElementById('infoBtn'), dlg = document.getElementById('infoDlg');
    if (!btn || !dlg) return;
    // Rendered inside the header slot; move it out so it doesn't inherit the nav's styles (nowrap, uppercase links).
    document.body.appendChild(dlg);
    btn.addEventListener('click', () => dlg.showModal());
    dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target.closest('[data-close]')) dlg.close(); });
  })();
</script>

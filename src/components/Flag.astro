---
// Small inline flag for the language switcher (SVG, not emoji: Windows has no flag emoji).
// Simplified designs that read at ~20 px; EN uses the US flag.
interface Props {
  code: string;
}
const { code } = Astro.props;
/** Five-pointed star polygon points, rotated so a point aims at `angle` (degrees, 0 = up). */
const star = (cx: number, cy: number, r: number, angle = 0) =>
  Array.from({ length: 10 }, (_, i) => {
    const a = ((angle + i * 36) * Math.PI) / 180,
      rr = i % 2 ? r * 0.382 : r;
    return `${(cx + rr * Math.sin(a)).toFixed(2)},${(cy - rr * Math.cos(a)).toFixed(2)}`;
  }).join(' ');
const usStripes = Array.from({ length: 7 }, (_, i) => i * (40 / 13));
---

<svg class="flag" viewBox="0 0 30 20" width="22" height="15" aria-hidden="true">
  {code === 'en' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      {usStripes.map((y) => (
        <rect y={y} width="30" height={20 / 13} fill="#b22234" />
      ))}
      <rect width="12" height={140 / 13} fill="#3c3b6e" />
    </>
  )}
  {code === 'pt-br' && (
    <>
      <rect width="30" height="20" fill="#009b3a" />
      <polygon points="15,2.2 27.5,10 15,17.8 2.5,10" fill="#fedf00" />
      <circle cx="15" cy="10" r="4.3" fill="#002776" />
    </>
  )}
  {code === 'ko' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      <g transform="rotate(33.7 15 10)">
        <path d="M10 10a5 5 0 0 1 10 0z" fill="#cd2e3a" />
        <path d="M10 10a5 5 0 0 0 10 0z" fill="#0047a0" />
        <circle cx="12.5" cy="10" r="2.5" fill="#cd2e3a" />
        <circle cx="17.5" cy="10" r="2.5" fill="#0047a0" />
      </g>
      {[
        [-33.7, 4.2, 5.4],
        [33.7, 25.8, 5.4],
        [33.7, 4.2, 14.6],
        [-33.7, 25.8, 14.6],
      ].map(([a, x, y]) => (
        <g transform={`rotate(${a} ${x} ${y})`} fill="#000">
          <rect x={x - 2} y={y - 1.8} width="4" height="0.8" />
          <rect x={x - 2} y={y - 0.4} width="4" height="0.8" />
          <rect x={x - 2} y={y + 1} width="4" height="0.8" />
        </g>
      ))}
    </>
  )}
  {code === 'ja' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      <circle cx="15" cy="10" r="6" fill="#bc002d" />
    </>
  )}
  {code === 'zh' && (
    <>
      <rect width="30" height="20" fill="#de2910" />
      <polygon points={star(5, 5, 3)} fill="#ffde00" />
      {[
        [10, 2, 23],
        [12, 4, 45],
        [12, 7, 70],
        [10, 9, 90],
      ].map(([x, y, a]) => (
        <polygon points={star(x, y, 1, a + 180)} fill="#ffde00" />
      ))}
    </>
  )}
  {code === 'de' && (
    <>
      <rect width="30" height="6.67" fill="#000" />
      <rect y="6.67" width="30" height="6.67" fill="#dd0000" />
      <rect y="13.33" width="30" height="6.67" fill="#ffce00" />
    </>
  )}
  {code === 'ru' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      <rect y="6.67" width="30" height="6.67" fill="#0039a6" />
      <rect y="13.33" width="30" height="6.67" fill="#d52b1e" />
    </>
  )}
</svg>

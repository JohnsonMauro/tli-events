---
// /ss14/<lang>/ — the play sheet in the other languages (texts in src/sheets/ss14/i18n/).
import PlaySheet from '../../sheets/ss14/PlaySheet.astro';
import { DEFAULT_LANG, LANGS, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.filter((l) => l.code !== DEFAULT_LANG).map((l) => ({ params: { lang: l.code } }));
}
const lang = Astro.params.lang as Lang;
---

<PlaySheet lang={lang} />

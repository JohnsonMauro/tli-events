---
import '../styles/site.css';
import { SEASONS, url } from '../seasons';

interface Props {
  title: string;
  description?: string;
  /** Section anchors shown in the top bar (map page). */
  anchors?: { href: string; label: string }[];
  season?: string;
}

const { title, description = 'Torchlight: Infinite season strategy', anchors = [], season } = Astro.props;
const current = SEASONS.find((s) => s.slug === season);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Stencil+Display:wght@700;800&family=IBM+Plex+Mono:wght@400;500&family=Barlow+Semi+Condensed:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    // Apply the saved theme before paint (per-viewer convenience only).
    try { const t = localStorage.getItem('tt-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <nav><div class="in">
    <a class="brand" href={url()}>TLI</a>
    {current && <>
      <a href={url(`${current.slug}/`)}><b>{current.code}</b> map</a>
      <a href={url(`${current.slug}/guide/`)}>guide</a>
      <a href={url(`${current.slug}/changelog/`)}>changelog</a>
      <span class="sep">·</span>
    </>}
    {anchors.map((a) => <a href={a.href}>{a.label}</a>)}
    <button id="theme" type="button">theme</button>
  </div></nav>
  <main>
    <slot />
  </main>
  <script is:inline>
    document.getElementById('theme').addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('tt-theme', root.dataset.theme); } catch (e) {}
    });
  </script>
</body>
</html>

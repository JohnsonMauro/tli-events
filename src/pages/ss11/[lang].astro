---
// /ss11/<lang>/ — the Vorax play sheet in the other languages (texts in src/sheets/ss11/i18n/).
import PlaySheet from '../../sheets/ss11/PlaySheet.astro';
import { DEFAULT_LANG, LANGS, type Lang } from '../../lib/i18n';

export function getStaticPaths() {
  return LANGS.filter((l) => l.code !== DEFAULT_LANG).map((l) => ({ params: { lang: l.code } }));
}
const lang = Astro.params.lang as Lang;
---

<PlaySheet lang={lang} />

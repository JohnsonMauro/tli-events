---
import { Font, fontData, getImage } from 'astro:assets';
import '../styles/theme.css';
import '../styles/site.css';
import { homeUrl, url } from '../lib/events';
import Flag from '../components/Flag.astro';
import { BUILD_ID } from '../lib/build';
import { SITE_TEXT, langOfTag, type Lang } from '../lib/i18n';
// The heading face comes in two files (Latin, then latin-ext: astro.config.mjs); preload only the Latin one. The
// `preload` filter can't tell them apart (a local font has no subset), so the link is written here.
const displayLatin = fontData['--font-display']?.[0]?.src[0]?.url;

interface Props {
  title: string;
  description?: string;
  /** Full-width main area (the play sheet fills the viewport). */
  wide?: boolean;
  /** Page language (BCP 47). */
  lang?: string;
  /** Translations of this page: language switcher + hreflang links. */
  langs?: { code: string; label: string; name: string; hreflang: string; href: string; current: boolean }[];
  /** Share image (Open Graph / Twitter card), e.g. the event's key art. */
  image?: ImageMetadata;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
}

const SITE_NAME = 'TLI Events';
const {
  title,
  description = 'Torchlight: Infinite season event strategy: rules, odds and picks, backed by sources.',
  wide = false,
  lang = 'en',
  langs = [],
  image,
  noindex = false,
} = Astro.props;
const abs = (path: string) => new URL(path, Astro.site ?? Astro.url).href;
const canonical = abs(Astro.url.pathname);
// JPEG for the share card: every chat app and crawler reads it (WebP support is still uneven there).
const og = image ? await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 }) : null;
const site = SITE_TEXT[langOfTag(lang)];
const [footBefore, footAfter = ''] = site.madeWith.split('{heart}');
// The translation offer (../lib/lang-offer.ts): every translation of this page, each worded in its own language.
const offerJson =
  langs.length > 1
    ? JSON.stringify({
        current: (langs.find((l) => l.current) ?? langs[0]).code,
        offers: langs.map((l) => {
          const t = SITE_TEXT[l.code as Lang];
          return {
            code: l.code,
            hreflang: l.hreflang,
            href: l.href,
            text: t.offer,
            go: t.offerGo,
            never: t.offerNever,
            close: t.offerClose,
          };
        }),
      }).replace(/</g, '\\u003c')
    : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {langs.map((l) => (
      <link rel="alternate" hreflang={l.hreflang} href={abs(l.href)} />
    ))}
    {langs.length > 0 && <link rel="alternate" hreflang="x-default" href={abs(langs[0].href)} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && (
      <>
        <meta property="og:image" content={abs(og.src)} />
        <meta property="og:image:width" content={String(og.attributes.width)} />
        <meta property="og:image:height" content={String(og.attributes.height)} />
      </>
    )}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    {/* The commit this page was built from (src/lib/build.ts): the update check below compares it with the live one. */}
    <meta name="tli-build" content={BUILD_ID} />
    {/* Search Console ownership (URL-prefix property for the Pages project site). Keep it: removing it unverifies the site. */}
    <meta name="google-site-verification" content="INWse-XtGLavB8Tu7RXajMkwTpACvo8dxvEqqKnCkv4" />
    {/* Self-hosted (astro.config.mjs `fonts`); preload only what paints first: body text (regular + bold) and headings, Latin. */}
    <Font
      cssVariable="--font-sans"
      preload={[
        { weight: '400', subset: 'latin' },
        { weight: '700', subset: 'latin' },
      ]}
    />
    <Font cssVariable="--font-display" />
    {displayLatin && <link rel="preload" href={displayLatin} as="font" type="font/woff2" crossorigin />}
    <Font cssVariable="--font-mono" />
    <script is:inline>
      // Apply the saved theme before paint (per-viewer convenience only).
      try {
        const t = localStorage.getItem('tt-theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <nav>
      <div class="in">
        <div class="links">
          <a class="brand" href={homeUrl(langOfTag(lang))}>
            TLI <span>Events</span>
          </a>
        </div>
        <div class="nav-end">
          <slot name="nav" />
          {langs.length > 0 &&
            (() => {
              const cur = langs.find((l) => l.current) ?? langs[0];
              return (
                <details class="lang-select">
                  <summary aria-label={`Language: ${cur.name}`}>
                    <Flag code={cur.code} />
                    <span>{cur.name}</span>
                  </summary>
                  {/* eslint-disable-next-line astro/jsx-a11y/no-redundant-roles -- Safari drops list semantics under list-style:none */}
                  <ul role="list">
                    {langs.map((l) => (
                      <li>
                        <a
                          href={l.href}
                          data-lang={l.code}
                          hreflang={l.hreflang}
                          lang={l.hreflang}
                          aria-current={l.current ? 'page' : undefined}
                        >
                          <Flag code={l.code} />
                          {l.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })()}
          <button id="theme" type="button" aria-label="Toggle light/dark theme" title="Toggle light/dark theme">
            <svg class="ico ico-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
            </svg>
            <svg class="ico ico-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </div>
    </nav>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <footer class="site-foot">
      {footBefore}
      {/* Beats for as long as the page is open, so it is its own pause button (WCAG 2.2.2) */}
      <button type="button" class="heart" id="heart" aria-label={site.pause} title={site.pause}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.8 4.5c2.1 0 3.6 1.2 5.2 3.1 1.6-1.9 3.1-3.1 5.2-3.1 3.8 0 5.9 3.9 4.4 7.3C19.5 16.4 12 21 12 21z" />
        </svg>
      </button>
      {footAfter}
    </footer>
    <script is:inline>
      // The heart beats only once this runs (no script = no pause control = no motion). Paused stays paused in this
      // browser; reduced motion starts paused.
      (() => {
        const heart = document.getElementById('heart');
        const KEY = 'tt-heart';
        let saved = null;
        try {
          saved = localStorage.getItem(KEY);
        } catch {}
        const still = saved ? saved === 'still' : matchMedia('(prefers-reduced-motion: reduce)').matches;
        heart.setAttribute('aria-pressed', String(still));
        heart.addEventListener('click', () => {
          const now = heart.getAttribute('aria-pressed') !== 'true';
          heart.setAttribute('aria-pressed', String(now));
          try {
            localStorage.setItem(KEY, now ? 'still' : 'beat');
          } catch {}
        });
      })();
    </script>
    {/* Bottom notices share one fixed stack, so two never cover each other: the translation offer above, the
        "new version" notice (it matters more) at the edge. */}
    <div class="notices">
      {offerJson && (
        <>
          {/* Filled and shown by ../lib/lang-offer.ts, in the language it offers; never shown twice once answered. */}
          <div class="lang-offer" id="lang-offer" hidden></div>
          <script type="application/json" id="lang-offer-data" set:html={offerJson} />
        </>
      )}
      <div class="update-toast" id="update-toast" role="status" hidden>
        <span>{site.newVersion}</span>
        <button type="button">{site.reload}</button>
      </div>
    </div>
    <script is:inline>
      const langSel = document.querySelector('.lang-select');
      if (langSel) {
        document.addEventListener('click', (e) => {
          if (!langSel.contains(e.target)) langSel.open = false;
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') langSel.open = false;
        });
      }
      document.getElementById('theme').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try {
          localStorage.setItem('tt-theme', root.dataset.theme);
        } catch {}
      });
    </script>
    <script>
      import { offerLanguage } from '../lib/lang-offer';
      import { watchForUpdates } from '../lib/update-check';
      watchForUpdates();
      offerLanguage();
    </script>
    {import.meta.env.PROD && (
      // Page-view counts (GoatCounter: no cookies, no personal data). Async, off the critical path.
      <script
        is:inline
        data-goatcounter="https://tlievents.goatcounter.com/count"
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
    {import.meta.env.PROD && <script is:inline define:vars={{ sw: url('sw.js'), scope: url() }}>
      // Offline + instant repeat visits (public/sw.js). Pages can't send long cache headers; the worker can.
      if ('serviceWorker' in navigator)
        addEventListener('load', () => navigator.serviceWorker.register(sw, { scope }).catch(() => {})); // eslint-disable-line @typescript-eslint/no-empty-function -- the site works without it
    </script>}
  </body>
</html>

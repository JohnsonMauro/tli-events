{
  "name": "tli-events",
  "private": true,
  "version": "1.20.2",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "astro build && playwright test",
    "icons": "node scripts/icons.mjs",
    "readme-shots": "node scripts/readme-shots.mjs",
    "data": "for s in events/*/scripts/update_data.py; do python3 -I \"$s\" || exit 1; done",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.13.0"
  }
}
